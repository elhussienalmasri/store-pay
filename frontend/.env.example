NEXT_PUBLIC_SOLANA_NETWORK=devnet
NEXT_PUBLIC_SOLANA_RPC_URL=https://api.devnet.solana.com
NEXT_PUBLIC_PROGRAM_ID=YOUR_PROGRAM_ID
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Signs the merchant session cookie. Optional in development: when unset,
# the server generates data/.auth-secret once and reuses it across restarts.
# Use a random string of at least 32 characters in production.
AUTH_SECRET=

# Optional email notifications. Configure SMTP_HOST + MAIL_FROM, or
# RESEND_API_KEY + MAIL_FROM. Do not use NEXT_PUBLIC_ for these values.
# When configured, buyers and merchants receive emails about sales, purchases,
# and available payments. Without email configuration, these notifications
# remain available in the StorePay app.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# Or Resend
RESEND_API_KEY=
MAIL_FROM=
